[Unit]
Description=OpenClaw mail polling worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=forrestmo
Group=forrestmo
WorkingDirectory=/opt/openclaw-mail
EnvironmentFile=/opt/openclaw-mail/.env
Environment=HOME=/home/forrestmo
ExecStart=/usr/bin/env node src/index.js
